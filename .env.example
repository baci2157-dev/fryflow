# ─────────────────────────────────────────────────────────────
# FryFlow · переменные окружения (пример)
#
# Скопируйте файл:  cp .env.example .env.local
# Все переменные НЕобязательны: без них FryFlow работает
# на локальных моках (localStorage) — демо-данные внутри.
# ─────────────────────────────────────────────────────────────

# ── Supabase (единый источник правды, задача 8) ──────────────
# Где взять: Supabase → ваш проект → Project Settings → API.
# Схема таблиц: supabase/schema.sql (SQL Editor → Run).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Telegram (ТОЛЬКО серверные — никогда не NEXT_PUBLIC_!) ───
# Bot Token от @BotFather и ваш Chat ID (узнать: @userinfobot).
# Нужны API-роутам: тест сообщения, алерты ИИ, автопостинг,
# вебхук заявок. Используются, если .data/telegram.json пуст
# (например, при деплое на Vercel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Каталог серверных данных Telegram ─────────────────────────
# По умолчанию <корень проекта>/.data — переживает пересборку.
# Укажите, если храните данные вне проекта (self-hosted деплой).
# FRYFLOW_DATA_DIR=/var/lib/fryflow

# ── База песочницы (не трогать — для локального стенда) ──────
# DATABASE_URL=

# ── ИИ-Директор и «Разведчик» (задачи 10–12) ────────────────
# Публичный API Z.AI: ключ из личного кабинета Z.AI (API Keys).
# С ключом ИИ работает в продакшене через https://api.z.ai —
# модель glm-4.7-flash (бесплатная). Без ключа — SDK песочницы
# (только локальная разработка, на деплое внутренний API недоступен).
# Веб-поиск в публичном API может быть платным: включается
# переключателем в «Настройках» (по умолчанию выключен).
# «Разведчик» использует поиск всегда — без него он не работает.
ZAI_API_KEY=

# Модель публичного режима (по умолчанию glm-4.7-flash — бесплатная).
# Для режима песочницы — каскад glm-5.2-fast-preview → glm-5.3 →
# glm-4.5 (см. src/lib/ai-sdk.ts и src/lib/ai-model.ts).
# FRYFLOW_AI_MODEL=glm-4.7-flash
